__id__ = "hello_moka"
__name__ = "Привет, мока"
__description__ = "Пробный плагин: пункт в меню сообщения и замена текста"
__author__ = "ecronx"
__version__ = "0.1.0"
__icon__ = "☕"
__min_version__ = "0.1.0"
__permissions__ = ["messages.send", "ui"]

from mokagram_sdk.base_plugin import BasePlugin, HookResult, HookStrategy, MenuItem


class Hello(BasePlugin):
    def on_plugin_load(self):
        self.add_menu_item(MenuItem(location="message", text="Привет из плагина",
                                    action=lambda msg: print("клик по сообщению", msg)))

    def send_message_hook(self, params):
        text = params.get("text", "")
        if text.endswith(" :moka:"):
            params["text"] = text.replace(" :moka:", " ☕")
            return HookResult(HookStrategy.MODIFY, params)
        return HookResult()
